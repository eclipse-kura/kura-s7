<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.kura</groupId>
        <artifactId>kura-s7</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>org.eclipse.kura.driver.s7plc.provider</artifactId>
    <description>S7 PLC Communication Driver</description>

    <properties>
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.basedir}/../tests/*/target/site/jacoco-aggregate/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>

        <!-- name of the jar embedded in the bundle, see -includeresource below -->
        <driver.block.jar>${project.build.directory}/lib/org.eclipse.kura.driver.block.jar</driver.block.jar>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.kura</groupId>
            <artifactId>org.eclipse.kura.api</artifactId>
        </dependency>
        <!-- exports org.eclipse.kura.core.configuration.metatype -->
        <dependency>
            <groupId>org.eclipse.kura</groupId>
            <artifactId>org.eclipse.kura.core.configuration</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.kura</groupId>
            <artifactId>org.eclipse.kura.util</artifactId>
        </dependency>
        <!-- embedded in the bundle, it is not part of the Kura runtime -->
        <dependency>
            <groupId>org.eclipse.kura</groupId>
            <artifactId>org.eclipse.kura.driver.block</artifactId>
        </dependency>
        <!-- shipped as a separate bundle by the Debian package -->
        <dependency>
            <groupId>org.eclipse.kura</groupId>
            <artifactId>org.moka7</artifactId>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.metatype.annotations</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Makes org.eclipse.kura.driver.block available to bnd under a
                stable, version-less file name so that it can be inlined in the
                bundle. The library is not installed in the Kura framework, so
                it has to travel inside this bundle as it did in the Kura
                monorepo build (Bundle-ClassPath: lib/...).
            -->
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-embedded-libs</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeArtifactIds>org.eclipse.kura.driver.block</includeArtifactIds>
                            <excludeTransitive>true</excludeTransitive>
                            <stripVersion>true</stripVersion>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>biz.aQute.bnd</groupId>
                <artifactId>bnd-maven-plugin</artifactId>
                <configuration>
                    <includeClassesDir>true</includeClassesDir>
                    <bnd><![CDATA[
                        Bundle-Name: S7 PLC Communication Driver
                        Bundle-SymbolicName: ${project.artifactId};singleton:=true
                        Bundle-Vendor: Eclipse Kura
                        Bundle-ActivationPolicy: lazy
                        Service-Component: OSGI-INF/*.xml
                        Import-Package: \
                            Moka7;version="[1.0,1.1)",\
                            org.eclipse.kura.driver;version="[1.0,1.1)",\
                            *
                        -includeresource: about_files=about_files/,\
                            about.html,\
                            OSGI-INF=OSGI-INF/,\
                            @${driver.block.jar}!/!(META-INF|about.html|about_files)/*
                        ]]></bnd>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
